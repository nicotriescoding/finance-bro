{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["@cloudflare/workers-types"],
        // "@/*" resolves into the Next app's src/ so the worker bundles the
        // SAME question banks, engine and grading the client uses. esbuild
        // (via wrangler's `tsconfig` option) honors these paths.
        "baseUrl": "..",
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": ["src/**/*.ts"]
}
