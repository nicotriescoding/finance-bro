# PostHog analytics — prepared but OFF until the key exists.
#
# To go live:
#   1. Create a project on PostHog Cloud EU (https://eu.posthog.com) — EU
#      region (Frankfurt) on purpose; the privacy policy promises EU hosting.
#   2. Set both vars in Vercel → Project → Settings → Environment Variables.
#
# Even with the key set, analytics only starts for visitors who accepted the
# cookie banner (see src/lib/analytics.ts).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Multiplayer worker (Cloudflare) — OFF until the URL exists.
# Without it, /multiplayer shows the canon placeholder (hard rule 1: the
# backend is an optional extra, never on the read path).
#
# To go live:
#   1. Deploy worker/ to Cloudflare (see worker/README.md).
#   2. Set this in Vercel to the worker URL, e.g.
#      https://finance-bro-mp.<account>.workers.dev  (no trailing slash)
NEXT_PUBLIC_MP_URL=
