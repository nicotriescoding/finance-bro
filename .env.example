# PostHog analytics — LIVE since 2026-09-06 with the project token baked
# into src/lib/analytics.ts (PostHog Cloud EU, project "finance-bro"). These
# two only override it, e.g. to point a dev build at another project.
# Analytics still only starts for visitors who accepted the consent dialog.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Multiplayer worker (Cloudflare) — OFF until the URL exists.
# Without it, /multiplayer shows the canon placeholder (hard rule 1: the
# backend is an optional extra, never on the read path).
#
# To go live:
#   1. Deploy worker/ to Cloudflare (see worker/README.md).
#   2. Set this in Vercel to the worker URL, e.g.
#      https://finance-bro-mp.<account>.workers.dev  (no trailing slash)
NEXT_PUBLIC_MP_URL=

# Google AdSense — LIVE: publisher id ca-pub-6951760347839431 is baked into
# src/lib/ads.ts. Set this to another id to override, or to `off` for a
# build without AdSense (own cookie banner, striped placeholders). Ad units
# go live per slot id in src/lib/ads.ts.
NEXT_PUBLIC_ADSENSE_CLIENT=
