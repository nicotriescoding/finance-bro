# PostHog analytics — prepared but OFF until the key exists.
#
# To go live:
#   1. Create a project on PostHog Cloud EU (https://eu.posthog.com) — EU
#      region (Frankfurt) on purpose; the privacy policy promises EU hosting.
#   2. Set both vars in Vercel → Project → Settings → Environment Variables.
#
# Even with the key set, analytics only starts for visitors who accepted the
# cookie banner (see src/lib/analytics.ts).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
